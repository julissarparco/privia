# PRIVIA — Plantilla de credenciales para correr el notebook FUERA de Colab.
# Copia este archivo a `.env` y completa los valores. NUNCA commitees el `.env`.
#
# En Colab no uses este archivo: crea los mismos nombres en 🔑 Secrets.

OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
REDIS_HOST=redis-xxxxx.redislabs.com
REDIS_PORT=14159
REDIS_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: ubicación del corpus si no usas la carpeta por defecto `./corpus/`
# PRIVIA_CORPUS_DIR=/ruta/absoluta/al/corpus
